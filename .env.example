# Backend settings. Copy to the repository-root .env and supply your private values.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL connection (server only; never add these values to client/).
# DATABASE_URL is optional. Leave blank to use the DB_* settings below.
DATABASE_URL=
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.gqnmtfdwbjmtonazhrhl
DB_PASSWORD=REPLACE_WITH_YOUR_SUPABASE_DATABASE_PASSWORD
DB_SSL=true
# Set to the local path of the Supabase root certificate downloaded from Database settings.
DB_SSL_CA_FILE=

# Use your own private random value of at least 32 characters.
JWT_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET
JWT_EXPIRES_IN=7d
