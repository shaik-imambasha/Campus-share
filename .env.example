# Backend settings. Copy this file to .env and enter values from your own setup.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Configure DATABASE_URL OR the DB_* fields below, not both.
# If your password has URL-reserved characters, percent-encode them in DATABASE_URL.
DATABASE_URL=

# Alternative connection fields used when DATABASE_URL is blank.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Generate a private random value at least 32 characters long for your local .env.
JWT_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET
JWT_EXPIRES_IN=7d
