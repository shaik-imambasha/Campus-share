# Backend settings. Copy to the repository-root .env and supply your private values.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Supabase PostgreSQL connection (server only; never add these values to client/).
# DATABASE_URL is optional. Leave blank to use the DB_* settings below.
DATABASE_URL=
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.gqnmtfdwbjmtonazhrhl
DB_PASSWORD=REPLACE_WITH_YOUR_SUPABASE_DATABASE_PASSWORD
DB_SSL=true
# Local development can use the downloaded certificate file path.
DB_SSL_CA_FILE=
# Render: set to the base64-encoded contents of the Supabase root certificate.
DB_SSL_CA_BASE64=

# Use your own private random value of at least 32 characters.
JWT_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Required for login approval links, account verification, and password reset.
# For Gmail, use a Google App Password; never use your account password.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
